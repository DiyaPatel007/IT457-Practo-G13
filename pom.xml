<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 3.5.x: the line the aws-serverless-java-container-springboot3 library is built and tested against. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>edu.dau.practolite</groupId>
    <artifactId>practo-lite</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>practo-lite</name>
    <description>Practo-inspired serverless appointment platform (IT457 Cloud Computing, Group 13)</description>

    <modules>
        <module>common</module>
        <module>test-support</module>
        <module>users-service</module>
        <module>doctors-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <aws.sdk.version>2.57.12</aws.sdk.version>
        <aws.serverless.container.version>2.1.7</aws.serverless.container.version>
        <aws.lambda.core.version>1.4.1</aws.lambda.core.version>
        <crac.version>1.5.0</crac.version>
        <dynamodb.local.version>2.6.1</dynamodb.local.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>edu.dau.practolite</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>edu.dau.practolite</groupId>
                <artifactId>test-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.amazonaws.serverless</groupId>
                <artifactId>aws-serverless-java-container-springboot3</artifactId>
                <version>${aws.serverless.container.version}</version>
            </dependency>
            <dependency>
                <groupId>com.amazonaws</groupId>
                <artifactId>aws-lambda-java-core</artifactId>
                <version>${aws.lambda.core.version}</version>
            </dependency>
            <dependency>
                <groupId>org.crac</groupId>
                <artifactId>crac</artifactId>
                <version>${crac.version}</version>
            </dependency>
            <dependency>
                <groupId>com.amazonaws</groupId>
                <artifactId>DynamoDBLocal</artifactId>
                <version>${dynamodb.local.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Copies runtime dependencies to target/lib so the Lambda zip can hold them as separate jars. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>copy-lambda-dependencies</id>
                            <phase>package</phase>
                            <goals>
                                <goal>copy-dependencies</goal>
                            </goals>
                            <configuration>
                                <outputDirectory>${project.build.directory}/lib</outputDirectory>
                                <includeScope>runtime</includeScope>
                            </configuration>
                        </execution>
                        <!-- DynamoDB Local (tests only) needs the sqlite4java native library on disk. -->
                        <execution>
                            <id>copy-native-libs</id>
                            <phase>process-test-resources</phase>
                            <goals>
                                <goal>copy-dependencies</goal>
                            </goals>
                            <configuration>
                                <outputDirectory>${project.build.directory}/native-libs</outputDirectory>
                                <includeScope>test</includeScope>
                                <includeTypes>so,dll,dylib</includeTypes>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <!--
                  Builds target/<module>-lambda.zip: compiled classes at the zip root and dependencies in lib/.
                  The Lambda Java runtime puts every jar in lib/ on the classpath. This layout starts faster
                  than one shaded jar and is the layout recommended for aws-serverless-java-container.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>lambda-zip</id>
                            <phase>package</phase>
                            <goals>
                                <goal>single</goal>
                            </goals>
                            <configuration>
                                <appendAssemblyId>false</appendAssemblyId>
                                <finalName>${project.artifactId}-lambda</finalName>
                                <descriptors>
                                    <descriptor>${maven.multiModuleProjectDirectory}/build-support/lambda-zip.xml</descriptor>
                                </descriptors>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Tests never talk to real AWS: give the SDK a fixed region and dummy credentials. -->
                        <environmentVariables>
                            <AWS_REGION>ap-south-1</AWS_REGION>
                            <AWS_ACCESS_KEY_ID>test</AWS_ACCESS_KEY_ID>
                            <AWS_SECRET_ACCESS_KEY>test</AWS_SECRET_ACCESS_KEY>
                        </environmentVariables>
                        <systemPropertyVariables>
                            <sqlite4java.library.path>${project.build.directory}/native-libs</sqlite4java.library.path>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
