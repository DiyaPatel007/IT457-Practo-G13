<mxfile host="app.diagrams.net" type="device">
  <diagram id="practolite-arch" name="Practo-Lite architecture on AWS">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ AWS Cloud / Region ============ -->
        <mxCell id="cloud" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="160" y="20" width="1200" height="740" as="geometry" />
        </mxCell>
        <mxCell id="region" value="Asia Pacific (Mumbai) ap-south-1 &amp;nbsp;-&amp;nbsp; one AWS SAM template, no servers, no VPC" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="60" width="1150" height="680" as="geometry" />
        </mxCell>

        <!-- ============ Clients (outside AWS) ============ -->
        <mxCell id="users" value="Patients, doctors,&lt;br&gt;admin&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(Postman / app)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="70" height="70" as="geometry" />
        </mxCell>

        <!-- ============ Edge services ============ -->
        <mxCell id="cognito" value="Amazon Cognito&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;user pool, groups:&lt;br&gt;Patient / Doctor / Admin&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="apigw" value="Amazon API Gateway&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;HTTP API: JWT check,&lt;br&gt;200 req/s throttle, access logs&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="330" y="335" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ec2" value="k6 load generator&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;EC2, same region&lt;br&gt;(experiments only)&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1">
          <mxGeometry x="230" y="560" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- ============ Lambda functions ============ -->
        <mxCell id="lambdagrp" value="AWS Lambda &amp;nbsp;-&amp;nbsp; Java 21 + Spring Boot, alias &quot;live&quot;, SnapStart" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=1;fontColor=#ED7100;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="530" y="150" width="250" height="470" as="geometry" />
        </mxCell>
        <mxCell id="lusers" value="Users function&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;register, profile, verify doctor&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="625" y="195" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ldoctors" value="Doctors function&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;profile, search, slots&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="625" y="335" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lappts" value="Appointments function&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;book, list, cancel, status&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="625" y="475" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- ============ DynamoDB tables ============ -->
        <mxCell id="ddbgrp" value="Amazon DynamoDB &amp;nbsp;-&amp;nbsp; on-demand" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAEDFB;strokeColor=#C925D1;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=1;fontColor=#C925D1;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="900" y="110" width="230" height="560" as="geometry" />
        </mxCell>
        <mxCell id="tusers" value="Users" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="990" y="150" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tdoctors" value="Doctors&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;+ search index (verified only)&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="990" y="270" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tslots" value="Slots&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;30-minute grid&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="990" y="400" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tappts" value="Appointments&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;+ patient and doctor indexes&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="990" y="530" width="50" height="50" as="geometry" />
        </mxCell>

        <!-- ============ Operations ============ -->
        <mxCell id="cw" value="Amazon CloudWatch&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;logs (7 days), metrics,&lt;br&gt;dashboard, alarms&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="625" y="655" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sam" value="AWS SAM / CloudFormation&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;creates and deletes everything&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1">
          <mxGeometry x="1220" y="110" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- ============ Edges: login and token ============ -->
        <mxCell id="e_login" value="1. log in,&lt;br&gt;get token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#DD344C;dashed=1;fontSize=11;fontColor=#DD344C;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="users" target="cognito">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_https" value="2. HTTPS +&lt;br&gt;Bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="users" target="apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_verify" value="3. verify&lt;br&gt;signature" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#DD344C;dashed=1;fontSize=11;fontColor=#DD344C;" edge="1" parent="1" source="apigw" target="cognito">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_k6" value="load tests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;dashed=1;fontSize=11;fontColor=#ED7100;" edge="1" parent="1" source="ec2" target="apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ Edges: API Gateway to functions ============ -->
        <mxCell id="e_gw_u" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1" source="apigw" target="lusers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gw_d" value="4. invoke" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="apigw" target="ldoctors">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gw_a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1" source="apigw" target="lappts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ Edges: functions to tables ============ -->
        <mxCell id="e_u_t" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;" edge="1" parent="1" source="lusers" target="tusers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_u_d" value="verify" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;dashed=1;fontSize=10;fontColor=#C925D1;" edge="1" parent="1" source="lusers" target="tdoctors">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d_d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;" edge="1" parent="1" source="ldoctors" target="tdoctors">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d_s" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;" edge="1" parent="1" source="ldoctors" target="tslots">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_a_s" value="5. one transaction:&lt;br&gt;slot BOOKED only if AVAILABLE" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;strokeWidth=1.5;fontSize=10;fontColor=#C925D1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lappts" target="tslots">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_a_a" value="+ create appointment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;strokeWidth=1.5;fontSize=10;fontColor=#C925D1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lappts" target="tappts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_u_cog" value="create user,&lt;br&gt;add to group" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#DD344C;dashed=1;fontSize=10;fontColor=#DD344C;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="lusers" target="cognito">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ Edges: logging ============ -->
        <mxCell id="e_logs" value="logs + metrics&lt;br&gt;(every component)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;dashed=1;fontSize=10;fontColor=#545B64;" edge="1" parent="1" source="lappts" target="cw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gw_cw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="cw">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="360" y="685" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;solid black: request path&lt;br&gt;purple: database reads/writes&lt;br&gt;red dashed: login and token checks&lt;br&gt;grey dashed: logs and metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontSize=10;fontColor=#545B64;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="610" width="170" height="90" as="geometry" />
