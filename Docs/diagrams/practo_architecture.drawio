        <mxCell id="sentry" value="&lt;b&gt;Sentry&lt;/b&gt;&lt;br&gt;errors and exceptions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="780" y="120" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- ============ Request-path edges (solid) ============ -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1" source="users" target="elb1">
          <mxGeometry relative="1" as="geometry" />
