        <!-- Observability (dashed) -->
        <mxCell id="e13" value="LB logs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;dashed=1;fontSize=11;" edge="1" parent="1" source="elb1" target="s3">
          <mxGeometry relative="1" as="geometry" />
