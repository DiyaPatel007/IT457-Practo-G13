        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;solid: request and data flow&lt;br&gt;pink: background jobs&lt;br&gt;dashed: logs, metrics, scaling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontSize=10;fontColor=#545B64;align=left;spacingLeft=8;" vertex="1" parent="1">
