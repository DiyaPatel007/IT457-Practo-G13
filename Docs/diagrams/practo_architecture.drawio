        <mxCell id="e5" value="reads / writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;exitX=0.15;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="k8s" target="rds">
