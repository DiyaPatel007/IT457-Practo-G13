        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;exitX=0.85;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="k8s" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="Tipoca Stream&lt;br&gt;(near real time)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;dashed=1;fontSize=11;fontColor=#8C4FFF;" edge="1" parent="1" source="rds" target="redshift">
          <mxGeometry relative="1" as="geometry" />
