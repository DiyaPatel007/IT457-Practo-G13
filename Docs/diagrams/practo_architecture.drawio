        <!-- Background processing -->
        <mxCell id="e9" value="enqueue jobs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#E7157B;fontSize=11;" edge="1" parent="1" source="k8s" target="sqs">
          <mxGeometry relative="1" as="geometry" />
