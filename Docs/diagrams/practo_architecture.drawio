          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="queue metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;dashed=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sqs" target="wpa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="scales" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;dashed=1;fontSize=11;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="wpa" target="workers">
          <mxGeometry relative="1" as="geometry" />
