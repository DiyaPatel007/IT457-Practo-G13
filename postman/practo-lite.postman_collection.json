        {
          "name": "Search doctors (#6)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/doctors?city=Gandhinagar&speciality=Dermatology",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "doctors"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "Gandhinagar"
                },
